# API key of a telegram bot.
TG_BOT_API="telegram-bot-api-key"

# An ID of a telegram channel to pull the information from.
TG_TRUSTED_CHANNEL_ID="id-of-the-channel-to-read-the-info-from"

# An ID of a telegram channel to log to.
TG_LOG_CHANNEL_ID="id-of-telegram-channel-to-output-logs-to"

# An ID of a trusted telegram user that will be injected as a superuser by default.
TG_SUPERUSER_ID="genesis-telegram-user-id"
TG_SUPERUSER_USERNAME="genesis-telegram-user-username"
TG_SUPERUSER_STATUS_ID="3"
TG_SUPERUSER_ROLE_ID="3"

# ChatGPT credentials.
CHAT_GPT_API="chat-gpt-api-key"
CHAT_GPT_URL="chat-gpt-url-to-make-calls-to"
CHAT_GPT_MODEL_PERPETUAL="custom-chat-gpt-model-for-trading-on-perpetual-swaps"
CHAT_GPT_MODEL_SPOT="custom-chat-gpt-model-for-trading-on-spot"

# PostgreSQL.
POSTGRES_USER="postgres-user"
POSTGRES_PASSWORD="postgres-passowrd"
POSTGRES_DB="postgres-db-name"
POSTGRES_HOST="postgres-host (e.g. localhost)"
POSTGRES_PORT="postgres-port (e.g 5432)"

DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Server credentials
SERVER_IP="server-ip-to-upload-the-project-to"
SERVER_USER="username-on-the-server"
SERVER_PROJECT_PATH="path/to/the/project/on/the/server"
SERVER_SSH_PORT="custom-ssh-port (e.g. 22)"

# Subscription bot credentials.
SUBSCRIPTION_BOT_URL="link-to-the-payment-service (e.g. telegram-bot-that-accepts-payments)"